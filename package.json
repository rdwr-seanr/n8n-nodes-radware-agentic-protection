{
  "name": "@radware/n8n-nodes-radware-agentic-protection",
  "version": "0.3.2",
  "description": "n8n community node for Radware Agentic AI Protection in-path enforcement",
  "license": "MIT",
  "homepage": "https://github.com/Radware/n8n-nodes-radware-agentic-protection#readme",
  "author": {
    "name": "Radware",
    "email": "seanr@radware.com",
    "url": "https://www.radware.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Radware/n8n-nodes-radware-agentic-protection.git"
  },
  "bugs": {
    "url": "https://github.com/Radware/n8n-nodes-radware-agentic-protection/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "npm run build && node --test tests/*.test.mjs",
    "scan": "npx @n8n/scan-community-package @radware/n8n-nodes-radware-agentic-protection",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist/credentials",
    "dist/icons",
    "dist/nodes",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "radware",
    "agentic-ai",
    "ai-security",
    "guardrails",
    "prompt-injection"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "aiNodeSdkVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/RadwareInPathApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/RadwareChatModel/RadwareChatModel.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.42.0",
    "eslint": "9.29.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "@n8n/ai-node-sdk": "*",
    "n8n-workflow": "*"
  },
  "contributors": [
    "Sean Ramati (https://github.com/rdwr-seanr)"
  ]
}
