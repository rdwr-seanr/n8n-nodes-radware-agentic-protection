{
  "name": "Radware In-Path Customer Chat Agent",
  "nodes": [
    {
      "parameters": {
        "options": {
          "responseMode": "lastNode"
        }
      },
      "id": "chat-trigger",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.4,
      "position": [0, 0]
    },
    {
      "parameters": {
        "promptType": "auto",
        "options": {
          "systemMessage": "You are a customer support AI Agent. Answer concisely. Your chat model is Radware Chat Model, so all LLM traffic is routed through Radware Agentic AI Protection."
        }
      },
      "id": "ai-agent",
      "name": "Customer Support AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [320, 0]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "options": {
          "temperature": 0
        }
      },
      "id": "radware-chat-model",
      "name": "Radware Chat Model",
      "type": "@radware/n8n-nodes-radware-agentic-protection.radwareChatModel",
      "typeVersion": 1,
      "position": [320, 220],
      "credentials": {
        "radwareInPathApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Radware In-Path API"
        }
      }
    },
    {
      "parameters": {
        "sessionKey": "={{ $json.sessionId || 'radware-demo-session' }}"
      },
      "id": "simple-memory",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.1,
      "position": [560, 220]
    }
  ],
  "connections": {
    "When chat message received": {
      "main": [
        [
          {
            "node": "Customer Support AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Radware Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Customer Support AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Simple Memory": {
      "ai_memory": [
        [
          {
            "node": "Customer Support AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "notes": "In-path customer pattern: the Chat Trigger sends user messages to an AI Agent whose chat model is Radware Chat Model. Create a Radware In-Path API credential before executing."
}
