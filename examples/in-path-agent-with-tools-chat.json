            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "notes": "In-path Behavioral validation requires actual tool context. Use a prompt such as: Read email with ID 12345 and complete the requested support follow-up action using the available tools."
