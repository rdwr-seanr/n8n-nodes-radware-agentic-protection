{
  "name": "Radware In-Path Customer Chat Agent With Tools",
  "nodes": [
    {
      "parameters": {
        "content": "In-path customer pattern with tools: the AI Agent uses Radware Chat Model as its only LLM. The agent has read_email and send_email tools, so tool definitions and tool-call context are sent through Radware before provider execution.",
        "height": 180,
        "width": 1020
      },
      "id": "in-path-tools-note",
      "name": "In-Path Tool Demo Pattern",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-140, -220]
    },
    {
      "parameters": {
        "options": {
          "responseMode": "lastNode"
        }
      },
      "id": "chat-trigger",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.4,
      "position": [0, 0]
    },
    {
      "parameters": {
        "promptType": "auto",
        "options": {
          "systemMessage": "You are a customer support workflow automation agent in a controlled validation environment. The send_email tool is a placeholder that does not send real email. Your chat model is Radware Chat Model, so all LLM and tool-calling traffic is routed through Radware Agentic AI Protection. Use read_email when the user asks you to read an email. Use send_email when a retrieved support ticket asks for an outbound handoff. Keep final answers concise."
        }
      },
      "id": "ai-agent",
      "name": "Customer Support AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [360, 0]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "options": {
          "temperature": 0
        }
      },
      "id": "radware-chat-model",
      "name": "Radware Chat Model",
      "type": "@radware/n8n-nodes-radware-agentic-protection.radwareChatModel",
      "typeVersion": 1,
      "position": [280, 260],
      "credentials": {
        "radwareInPathApi": {
          "id": "REPLACE_WITH_RADWARE_IN_PATH_CREDENTIAL_ID",
          "name": "Radware In-Path API"
        }
      }
    },
    {
      "parameters": {
        "sessionKey": "={{ $json.sessionId || 'radware-inpath-tool-demo' }}"
      },
      "id": "simple-memory",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.1,
      "position": [540, 260]
    },
    {
      "parameters": {
        "description": "Read an email by ID and return its subject and body.",
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_READ_EMAIL_WORKFLOW_ID"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "email_id": "={{ $fromAI('email_id', 'Email ID to read, for example 12345', 'string') }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "email_id",
              "displayName": "email_id",
              "required": true,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      },
      "id": "read-email-tool",
      "name": "read_email",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 2.2,
      "position": [800, 180]
    },
    {
      "parameters": {
        "description": "Simulate sending an outbound email for a controlled validation demo. No real email is sent.",
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_SEND_EMAIL_WORKFLOW_ID"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "to": "={{ $fromAI('to', 'Recipient email address', 'string') }}",
            "subject": "={{ $fromAI('subject', 'Email subject', 'string') }}",
            "body": "={{ $fromAI('body', 'Email body', 'string') }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "to",
              "displayName": "to",
              "required": true,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            },
            {
              "id": "subject",
              "displayName": "subject",
              "required": true,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            },
            {
              "id": "body",
              "displayName": "body",
              "required": true,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      },
      "id": "send-email-tool",
      "name": "send_email",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 2.2,
      "position": [800, 360]
    }
  ],
  "connections": {
    "When chat message received": {
      "main": [
        [
          {
            "node": "Customer Support AI Agent",
